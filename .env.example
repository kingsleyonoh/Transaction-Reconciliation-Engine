# Server
PORT=8080
API_KEY=xxxxx
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://user:password@localhost:5432/reconciliation?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Adapter Mode
USE_FIXTURES=false                    # true = use recorded fixtures (CI/tests), false = live API calls

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx        # sk_test_ for dev/sandbox, sk_live_ for production
STRIPE_SYNC_INTERVAL=6h

# PayPal
PAYPAL_CLIENT_ID=xxxxx                 # sandbox credentials for dev, live for production
PAYPAL_CLIENT_SECRET=xxxxx
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com   # sandbox.paypal.com for dev, api-m.paypal.com for production
PAYPAL_SYNC_INTERVAL=6h

# Reconciliation
RECONCILE_SCHEDULE=0 2 * * *
FUZZY_AMOUNT_TOLERANCE=0.005
FUZZY_DATE_TOLERANCE_DAYS=3
MIN_CONFIDENCE_THRESHOLD=0.70

# Discrepancy
HIGH_SEVERITY_THRESHOLD_CENTS=10000
CRITICAL_SEVERITY_THRESHOLD_CENTS=100000

# Sentry (optional)
SENTRY_DSN=xxxxx
